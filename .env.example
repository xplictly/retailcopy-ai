# RetailCopy AI — Environment Configuration
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.

# ── Application ────────────────────────────────────────────
APP_ENV=development
APP_NAME="RetailCopy AI"
APP_VERSION=1.0.0
SECRET_KEY=change-me-in-production-use-long-random-string
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/retailcopy.db

# ── CORS ────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Active AI Provider ──────────────────────────────────────
# Options: gemini | groq | openrouter | openai_compatible | ollama | demo
LLM_PROVIDER=demo

# ── Gemini (Primary) ────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Groq (Optional) ─────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenRouter (Optional) ───────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# ── OpenAI-Compatible (Optional) ────────────────────────────
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-3.5-turbo

# ── Ollama (Optional Local Inference) ───────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# ── Data Source URLs ────────────────────────────────────────
DUMMYJSON_BASE_URL=https://dummyjson.com
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# ── Import Limits ────────────────────────────────────────────
IMPORT_PAGE_SIZE=30
IMPORT_MAX_RECORDS=500
IMPORT_FILE_MAX_MB=10

# ── Batch Processing ────────────────────────────────────────
BATCH_SIZE=10
BATCH_CONCURRENCY=3
BATCH_RETRY_LIMIT=3
BATCH_RETRY_BACKOFF_BASE=2.0

# ── HTTP Client ──────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
